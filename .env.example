# ========================================
# Backend Environment Variables
# ========================================

# Node environment
NODE_ENV=production

# Server port (Render assigns this automatically)
PORT=5000

# MongoDB Connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/
# Get this from MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/

# Database name
MONGO_DB_NAME=trustpermit

# ========================================
# Optional: API Keys and Secrets
# ========================================

# JWT Secret (for future token implementation)
JWT_SECRET=your-secret-key-here

# Payment API Keys (Stripe, PayPal, etc.)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Email configuration (for notifications)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
EMAILJS_PUBLIC_KEY=

# ========================================
# Development/Testing
# ========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed error messages (disable in production)
DEBUG=false
